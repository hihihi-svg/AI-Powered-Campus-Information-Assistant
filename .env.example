# ==============================================================================
# AI-Powered Campus Information Assistant — Environment Variables
# ==============================================================================

# Application Port (7860 for Hugging Face Spaces; mapped to 8000 in local docker compose)
PORT=7860

# LLM Provider API Keys
# Optional: The assistant provides complete, grounded answers via evidence synthesis
# without external keys. Setting OPENAI_API_KEY enables GPT-based answer generation.
OPENAI_API_KEY=your_openai_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Gmail Synchronization Settings (Optional — disabled by default in production)
GMAIL_AUTO_SYNC=0
GMAIL_SYNC_INTERVAL_SECONDS=300

# Telemetry / Optimization
MLFLOW_DISABLE_AGENT_HINT=1
PYTHONUNBUFFERED=1

# LangSmith RAG Observability (Optional — disabled by default)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=rvce-campus-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_SANITIZE_TRACES=true


